{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 2
    },
    "stage": {
      "type": "string",
      "const": "research_in_progress"
    },
    "progress": {
      "type": "object",
      "properties": {
        "percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "audited": {
          "type": "boolean",
          "const": false
        },
        "usable_as_completion_metric": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "percent",
        "audited",
        "usable_as_completion_metric"
      ],
      "additionalProperties": false
    },
    "measured_progress": {
      "type": "object",
      "properties": {
        "metric": {
          "type": "string",
          "const": "seasons_with_documentary_leads"
        },
        "numerator": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "denominator": {
          "type": "number",
          "const": 55
        },
        "percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "audited_completion": {
          "type": "boolean",
          "const": false
        },
        "warning": {
          "type": "string"
        }
      },
      "required": [
        "metric",
        "numerator",
        "denominator",
        "percent",
        "audited_completion",
        "warning"
      ],
      "additionalProperties": false
    },
    "approved_results": {
      "type": "number",
      "const": 0
    },
    "scope": {
      "type": "object",
      "properties": {
        "first_year": {
          "type": "number",
          "const": 1971
        },
        "last_year": {
          "type": "number",
          "const": 2025
        },
        "seasons": {
          "type": "number",
          "const": 55
        },
        "excluded_pre_1971": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "first_year",
        "last_year",
        "seasons",
        "excluded_pre_1971"
      ],
      "additionalProperties": false
    },
    "audit_status": {
      "type": "string"
    },
    "last_collection_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "ranking_publication": {
      "type": "string",
      "const": "blocked"
    },
    "publication_reason": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "stage",
    "progress",
    "measured_progress",
    "approved_results",
    "scope",
    "audit_status",
    "last_collection_at",
    "ranking_publication",
    "publication_reason"
  ],
  "additionalProperties": false
}
