{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 3
    },
    "scope": {
      "type": "object",
      "properties": {
        "first_year": {
          "type": "number",
          "const": 1971
        },
        "last_year": {
          "type": "number",
          "const": 2025
        }
      },
      "required": [
        "first_year",
        "last_year"
      ],
      "additionalProperties": false
    },
    "total_seasons": {
      "type": "number",
      "const": 55
    },
    "seasons_without_leads": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "seasons_with_leads": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "lead_coverage_percent": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "ranking_approved": {
      "type": "boolean",
      "const": false
    },
    "warning": {
      "type": "string"
    },
    "tasks": {
      "minItems": 55,
      "maxItems": 55,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "year": {
            "type": "integer",
            "minimum": 1971,
            "maximum": 2025
          },
          "edition_id": {
            "type": "string"
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "stage": {
            "type": "string",
            "enum": [
              "discover_official_source",
              "archive_and_verify_source",
              "manual_historical_review"
            ]
          },
          "candidate_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "checked_source_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "archived_source_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "approved": {
            "type": "boolean",
            "const": false
          }
        },
        "required": [
          "year",
          "edition_id",
          "priority",
          "stage",
          "candidate_count",
          "source_ids",
          "checked_source_count",
          "archived_source_count",
          "approved"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "scope",
    "total_seasons",
    "seasons_without_leads",
    "seasons_with_leads",
    "lead_coverage_percent",
    "ranking_approved",
    "warning",
    "tasks"
  ],
  "additionalProperties": false
}
