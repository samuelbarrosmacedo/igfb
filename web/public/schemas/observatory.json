{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 3
    },
    "clubs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_:-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "crest": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^assets\\/identities\\/[a-z0-9_-]+\\.(svg|png|webp)$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "source_url": {
                    "type": "string",
                    "pattern": "^https:\\/\\/"
                  },
                  "license": {
                    "type": "string",
                    "minLength": 1
                  },
                  "attribution": {
                    "type": "string",
                    "minLength": 1
                  },
                  "usage_note": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "path",
                  "sha256",
                  "source_url",
                  "license",
                  "attribution",
                  "usage_note"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "colors": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          },
          "identity_source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_:-]*$"
            }
          },
          "official_name": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "abbreviation": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "state": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "city": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "name",
          "crest",
          "colors",
          "identity_source_ids",
          "official_name",
          "abbreviation",
          "state",
          "city"
        ],
        "additionalProperties": false
      }
    },
    "competitions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_:-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "crest": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^assets\\/identities\\/[a-z0-9_-]+\\.(svg|png|webp)$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "source_url": {
                    "type": "string",
                    "pattern": "^https:\\/\\/"
                  },
                  "license": {
                    "type": "string",
                    "minLength": 1
                  },
                  "attribution": {
                    "type": "string",
                    "minLength": 1
                  },
                  "usage_note": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "path",
                  "sha256",
                  "source_url",
                  "license",
                  "attribution",
                  "usage_note"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "colors": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          },
          "identity_source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_:-]*$"
            }
          },
          "scoring_category": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "jurisdiction": {
            "type": "string",
            "enum": [
              "national",
              "state",
              "continental",
              "world"
            ]
          },
          "state": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "organizer": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "format": {
            "type": "string",
            "enum": [
              "league",
              "cup",
              "mixed",
              "unknown"
            ]
          },
          "periodicity": {
            "type": "string",
            "enum": [
              "annual",
              "irregular",
              "discontinued",
              "not_documented"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "catalogued",
              "active",
              "discontinued"
            ]
          },
          "eligibility_note": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "name",
          "crest",
          "colors",
          "identity_source_ids",
          "scoring_category",
          "jurisdiction",
          "state",
          "organizer",
          "format",
          "periodicity",
          "status",
          "eligibility_note"
        ],
        "additionalProperties": false
      }
    },
    "editions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_:-]*$"
          },
          "competition_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_:-]*$"
          },
          "year": {
            "type": "integer",
            "minimum": 1971,
            "maximum": 9999
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "research",
              "scheduled",
              "ongoing",
              "finished",
              "cancelled"
            ]
          },
          "format": {
            "type": "string",
            "enum": [
              "league",
              "cup",
              "mixed",
              "unknown"
            ]
          },
          "participant_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_:-]*$"
            }
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_:-]*$"
            }
          },
          "updated_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "competition_id",
          "year",
          "label",
          "status",
          "format",
          "participant_ids",
          "source_ids",
          "updated_at"
        ],
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_:-]*$"
          },
          "url": {
            "type": "string",
            "pattern": "^https:\\/\\/"
          },
          "publisher": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string",
            "minLength": 1
          },
          "checked_on": {
            "anyOf": [
              {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "url",
          "publisher",
          "note",
          "checked_on"
        ],
        "additionalProperties": false
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_:-]*$"
          },
          "edition_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_:-]*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "result",
              "match",
              "standing",
              "statistic"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "collected",
              "in_review",
              "disputed",
              "provisional",
              "official_final"
            ]
          },
          "club_ids": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_:-]*$"
            }
          },
          "source_ids": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_:-]*$"
            }
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "phase": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "position": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "unit": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "home_score": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "away_score": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "played_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "revision": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "revision_note": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "edition_id",
          "kind",
          "status",
          "club_ids",
          "source_ids",
          "label",
          "phase",
          "position",
          "value",
          "unit",
          "home_score",
          "away_score",
          "played_at",
          "updated_at",
          "revision",
          "revision_note"
        ],
        "additionalProperties": false
      }
    },
    "current_season": {
      "type": "integer",
      "minimum": 1971,
      "maximum": 9999
    },
    "historical_scope": {
      "type": "object",
      "properties": {
        "first_year": {
          "type": "integer",
          "minimum": 1971,
          "maximum": 9999
        },
        "last_year": {
          "type": "integer",
          "minimum": 1971,
          "maximum": 9999
        }
      },
      "required": [
        "first_year",
        "last_year"
      ],
      "additionalProperties": false
    },
    "seasons": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1971,
        "maximum": 9999
      }
    },
    "collection_mode": {
      "type": "string",
      "const": "repository_records_only"
    }
  },
  "required": [
    "schema_version",
    "clubs",
    "competitions",
    "editions",
    "sources",
    "records",
    "current_season",
    "historical_scope",
    "seasons",
    "collection_mode"
  ],
  "additionalProperties": false
}
