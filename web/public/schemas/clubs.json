{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 2
    },
    "status": {
      "type": "string",
      "const": "identities_from_source_leads"
    },
    "scope_note": {
      "type": "string"
    },
    "clubs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "identity_status": {
            "type": "string",
            "const": "source_lead_identity"
          },
          "crest": {
            "type": "null"
          },
          "lead_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "years_with_leads": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1971,
              "maximum": 2025
            }
          },
          "titles": {
            "type": "null"
          },
          "score": {
            "type": "null"
          },
          "participations": {
            "type": "null"
          },
          "relegations": {
            "type": "null"
          }
        },
        "required": [
          "id",
          "name",
          "identity_status",
          "crest",
          "lead_count",
          "source_ids",
          "years_with_leads",
          "titles",
          "score",
          "participations",
          "relegations"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "status",
    "scope_note",
    "clubs"
  ],
  "additionalProperties": false
}
