{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 3
    },
    "status": {
      "type": "string",
      "const": "canonical_catalog"
    },
    "scope_note": {
      "type": "string"
    },
    "clubs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_:-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "crest": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^assets\\/identities\\/[a-z0-9_-]+\\.(svg|png|webp)$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "source_url": {
                    "type": "string",
                    "pattern": "^https:\\/\\/"
                  },
                  "license": {
                    "type": "string",
                    "minLength": 1
                  },
                  "attribution": {
                    "type": "string",
                    "minLength": 1
                  },
                  "usage_note": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "path",
                  "sha256",
                  "source_url",
                  "license",
                  "attribution",
                  "usage_note"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "colors": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          },
          "identity_source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_:-]*$"
            }
          },
          "official_name": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "abbreviation": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "state": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "city": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "identity_status": {
            "type": "string",
            "const": "catalogued"
          },
          "lead_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "years_with_leads": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1971,
              "maximum": 2025
            }
          },
          "titles": {
            "type": "null"
          },
          "score": {
            "type": "null"
          },
          "participations": {
            "type": "null"
          },
          "relegations": {
            "type": "null"
          }
        },
        "required": [
          "id",
          "name",
          "crest",
          "colors",
          "identity_source_ids",
          "official_name",
          "abbreviation",
          "state",
          "city",
          "identity_status",
          "lead_count",
          "source_ids",
          "years_with_leads",
          "titles",
          "score",
          "participations",
          "relegations"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "status",
    "scope_note",
    "clubs"
  ],
  "additionalProperties": false
}
