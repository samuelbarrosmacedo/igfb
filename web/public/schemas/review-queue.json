{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 2
    },
    "status": {
      "type": "string",
      "const": "manual_review_required"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "year": {
            "type": "integer",
            "minimum": 1971,
            "maximum": 2025
          },
          "edition_id": {
            "type": "string"
          },
          "claims": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "club_id": {
                  "type": "string"
                },
                "source_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "source_count": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "club_id",
                "source_ids",
                "source_count"
              ],
              "additionalProperties": false
            }
          },
          "has_competing_claims": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "const": "manual_review_required"
          },
          "approved": {
            "type": "boolean",
            "const": false
          }
        },
        "required": [
          "year",
          "edition_id",
          "claims",
          "has_competing_claims",
          "status",
          "approved"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "status",
    "items"
  ],
  "additionalProperties": false
}
