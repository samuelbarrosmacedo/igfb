{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 3
    },
    "source_leads": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "seasons_with_leads": {
      "type": "integer",
      "minimum": 0,
      "maximum": 55
    },
    "seasons_without_leads": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1971,
        "maximum": 2025
      }
    },
    "checked_source_pages": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "source_ids_without_archived_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "approved_results": {
      "type": "number",
      "const": 0
    },
    "catalogued_sources": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "archived_evidence_documents": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "verified_archives": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "archived_candidate_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "distinct_source_urls": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "lead_coverage_percent": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "coverage_metric": {
      "type": "string"
    },
    "archive_status": {
      "type": "string",
      "const": "inventory_verified"
    },
    "review_editions": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "competing_claim_editions": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1971,
        "maximum": 2025
      }
    },
    "denominator": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "source_leads",
    "seasons_with_leads",
    "seasons_without_leads",
    "checked_source_pages",
    "source_ids_without_archived_bytes",
    "approved_results",
    "catalogued_sources",
    "archived_evidence_documents",
    "verified_archives",
    "archived_candidate_count",
    "distinct_source_urls",
    "lead_coverage_percent",
    "coverage_metric",
    "archive_status",
    "review_editions",
    "competing_claim_editions",
    "denominator"
  ],
  "additionalProperties": false
}
